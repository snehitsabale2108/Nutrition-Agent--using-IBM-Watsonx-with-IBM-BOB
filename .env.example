# ============================================================
#  IBM Watsonx.ai — Nutrition Agent Configuration (EXAMPLE)
# ============================================================
#  Copy this file to .env and fill in your real credentials.
#  Never commit .env to source control.
# ============================================================

# --- IBM Cloud Credentials ---
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here
IBM_CLOUD_URL=https://us-south.ml.cloud.ibm.com

# --- Watsonx.ai Project ---
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# --- Flask App ---
FLASK_SECRET_KEY=change_this_to_a_long_random_secret_string
FLASK_ENV=development
FLASK_DEBUG=True

# --- Model Selection (IBM Granite) ---
# Options: ibm/granite-3-8b-instruct | ibm/granite-3-2b-instruct
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# --- Model Parameters ---
MAX_TOKENS=1200
TEMPERATURE=0.7
TOP_P=0.9
TOP_K=50
